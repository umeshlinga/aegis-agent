# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional second model family (used as the cross-family judge and fallback).
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_BALANCED=
OPENAI_MODEL_STRONG=
# Optional local model via Ollama / vLLM (OpenAI-compatible). Example:
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# Claude model IDs (defaults shown)
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_BALANCED=claude-sonnet-5-5
CLAUDE_MODEL_STRONG=claude-opus-5-5
# NCBI: free key raises the limit from 3 to 10 requests/s. https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=
# Hard spend cap per run (USD)
AEGIS_MAX_COST_USD=1.50
AEGIS_DB=data/aegis.db
# Browser: leave empty to use Playwright's Chromium, or point at Chrome
AEGIS_CHROME_PATH=
AEGIS_HEADLESS=1
# Retrieval: auto | fastembed | openai | hashing ; reranker: auto | cross_encoder | none
AEGIS_EMBEDDER=auto
AEGIS_RERANKER=auto
# Optional: ship spans to Jaeger/Tempo (needs the otel extra)
AEGIS_OTLP_ENDPOINT=
