# Copy to .env and fill in the providers you use. Keys are read from the
# environment (or this file) by aegis.models.http_adapters and are never
# printed or logged. No key is needed for local runs, tests, or evals.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local or open-weight endpoint (Ollama-style). Key optional.
AEGIS_LOCAL_BASE_URL=http://localhost:11434
AEGIS_LOCAL_MODEL=llama3.1
AEGIS_LOCAL_API_KEY=
